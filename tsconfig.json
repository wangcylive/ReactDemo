{
  "compilerOptions": {
    "esModuleInterop": true,
    "outDir": "./dist/",
    "noImplicitAny": true,
    "sourceMap": true,
    "module": "esnext",
    "target": "es5",
    "jsx": "react-jsx",
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "experimentalDecorators": true,
    "skipLibCheck": true,
    "removeComments": true,
    "downlevelIteration": true,
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "root/*": ["./*"]
    },
    "lib": ["es2017", "es2015.promise", "es2015.iterable", "dom", "DOM.Iterable"],
    "typeRoots": ["node_modules/@types"]
  }
}
